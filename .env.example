# عنوان مشروع Supabase (URL) — مثال: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# المفتاح العام (publishable / anon) — آمن للاستخدام في المتصفح
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# سرّ! مفتاح service_role يتجاوز كل سياسات RLS — لا يُكتب في ملف متتبَّع في git،
# ولا يُسبق ببادئة NEXT_PUBLIC_ أبدًا (تحقنه في حزمة المتصفّح).
# يُضبط في Vercel فقط. من: Supabase ← Project Settings ← API Keys ← service_role
# يستعمله مسارٌ واحد: إرسال إشعارات الطابور بعد إلغاء الضيف لدوره — لأن دواله
# سُحبت من anon كي لا تُعيد بيانات اشتراك الطابور لمن يملك المفتاح العام.
# SUPABASE_SERVICE_ROLE_KEY=

# ── إشعارات الدفع (Web Push) ───────────────────────────────────────────────
# المفتاح العام آمن للعلن ويُحقن وقت البناء
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# سرّ! يُضبط في إعدادات Vercel فقط — لا يُكتب في ملف متتبَّع في git.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── مراقبة الأخطاء (Sentry) ──
# اتركه فارغًا فلا يعمل شيء ولا يتعطّل شيء. عبّئه في Vercel ليبدأ الالتقاط.
# من: sentry.io ← مشروعك ← Settings ← Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# اختياري (لخرائط المصدر): Settings ← Auth Tokens
SENTRY_AUTH_TOKEN=
